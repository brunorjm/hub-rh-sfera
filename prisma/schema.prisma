generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model academia_hering {
  id            BigInt    @id @default(autoincrement())
  mes           DateTime  @db.Date
  nome          String
  cargo         String?
  loja          String?
  ultimo_acesso DateTime? @db.Date
  horas         Decimal?  @db.Decimal
  performance   Decimal?  @db.Decimal
  unidade       String?
  departamento  String?
  no_cadastro   Boolean   @default(false)
  nome_cadastro String?

  @@index([mes])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model acesso_log {
  id            BigInt   @id @default(autoincrement())
  usuario_id    String   @db.Uuid
  usuario_nome  String?
  usuario_email String?
  perfil        String?
  evento        String
  modulo        String?
  dispositivo   String?
  criado_em     DateTime @default(now()) @db.Timestamptz(6)

  @@index([criado_em(sort: Desc)], map: "acesso_log_criado_idx")
  @@index([usuario_id, criado_em(sort: Desc)], map: "acesso_log_usuario_idx")
}

