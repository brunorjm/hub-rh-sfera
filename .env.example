# =============================================================================
#  Hub Sfera — variáveis de ambiente (DESENVOLVIMENTO LOCAL)
#  cp .env.example .env  e preencha. Só nomes e instruções: nunca valor real aqui.
# =============================================================================

# --- Docker Compose local ----------------------------------------------------
# [obrigatória p/ compose] Senhas dos containers db e redis.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Banco ---------------------------------------------------------------------
# [obrigatória] Banco local do compose: 127.0.0.1:5435, usuário hub, banco hub_rh.
DATABASE_URL=postgresql://hub:<POSTGRES_PASSWORD>@127.0.0.1:5435/hub_rh?schema=public
# [opcional] Banco dos testes de integração (perfil test do compose, porta 5436).
DATABASE_URL_TEST=

# --- Autenticação --------------------------------------------------------------
# [obrigatória] URL do hub, sem barra no final.
NEXTAUTH_URL=http://localhost:3006
# [obrigatória] Mínimo 32 caracteres. Gerar: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Redis ---------------------------------------------------------------------
# [obrigatória] Sessões (revogação) e limite de tentativas de login.
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6380
# [obrigatória em homologação/produção] "true" atrás do proxy da hospedagem que
# ACRESCENTA o IP do cliente ao X-Forwarded-For (o servidor usa só o ÚLTIMO item).
# Sem ela o IP é desconhecido: os limites por IP (login e links públicos) ficam
# desligados e só valem os por e-mail e por token. Nunca "true" sem esse proxy na
# frente (o cliente inventaria o IP). Em dev local, deixe vazio.
TRUST_PROXY=

# --- Arquivos (PDFs da Conexão RH) ----------------------------------------------
# [obrigatória] "local" (dev, grava em _local/arquivos) ou "r2" (homologação/produção).
STORAGE_DRIVER=local
# [obrigatória com r2] Cloudflare R2 (API S3), bucket próprio do hub.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Twygo ---------------------------------------------------------------------
# [opcional] Sem ele, o job de sincronização do Twygo não roda.
TWYGO_API_TOKEN=

# --- Desenvolvimento ------------------------------------------------------------
# [opcional] Conta de TESTE local (scripts/criar-conta-teste.ts). Gere a senha; nunca use uma real.
DEV_EMAIL_TESTE=teste.local@hub.test
DEV_SENHA_TESTE=
